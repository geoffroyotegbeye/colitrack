# ============================================
# ColiTrack Backend — Variables d'environnement
# Copier en .env pour le développement local
# ============================================

# Serveur
PORT=3001
NODE_ENV=development

# URL du frontend (CORS)
# Local :
FRONTEND_URL=http://localhost:5173
# Production :
# FRONTEND_URL=https://colitrack.vercel.app

# PostgreSQL local (Docker) — lancer avec : docker compose up -d
DATABASE_URL=postgresql://colitrack:colitrack@localhost:5438/colitrack

# JWT
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=changer_cette_valeur_minimum_32_caracteres
JWT_EXPIRES_IN=7d
